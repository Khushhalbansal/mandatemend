# Copy to .env and fill in. .env is gitignored (CLAUDE.md §6).

# --- Database (idempotency is enforced here at the DB layer, CLAUDE.md §2/§6) ---
MANDATEMEND_DB_URL=postgresql+psycopg://mandatemend:mandatemend@localhost:5432/mandatemend

# --- LLM diagnosis (optional). If unset, the offline HeuristicDiagnoser is used. ---
# The heuristic diagnoser is a real rule-based classifier, NOT a fake-success stub (CLAUDE.md §1.3).
ANTHROPIC_API_KEY=
MANDATEMEND_LLM_MODEL=claude-sonnet-4-5
MANDATEMEND_DIAGNOSER=auto          # auto | llm | heuristic

# --- Razorpay test mode (optional). If unset, the executor uses the local SimulatedGateway. ---
# The simulated gateway replays the frozen batch's ground truth; it never fakes a success it
# cannot justify from the label file (CLAUDE.md §1.3).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
MANDATEMEND_EXECUTOR=simulated       # simulated | razorpay_test

# --- Batch / loop config ---
MANDATEMEND_HELDOUT_BATCH=data/heldout_batch.frozen.json
MANDATEMEND_HELDOUT_LABELS=data/heldout_labels.frozen.json
MANDATEMEND_ITER_LOG=logs/iterations.jsonl
